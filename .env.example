# Credenciais da ZF / Pro-Parts (opcional).
# A aplicação normalmente recebe client_id / client_secret pela própria interface
# (ficam salvos apenas no localStorage do navegador e nunca são commitados).
#
# Se preferir fixar as credenciais no servidor — assim elas nunca trafegam a
# partir do navegador — defina as variáveis abaixo na Vercel (Project Settings →
# Environment Variables) ou em um arquivo .env.local para rodar localmente.
# Quando definidas, elas têm prioridade sobre o que for digitado na interface.
ZF_CLIENT_ID=""
ZF_CLIENT_SECRET=""

# Base URL da API (só mude se a ZF fornecer um ambiente de homologação).
ZF_API_BASE_URL="https://api.pro-parts.com/retailer/v1"
